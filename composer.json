{
  "name": "voidstrike/arena",
  "description": "VOIDSTRIKE ARENA — Pure PHP 8.5 Full-Stack 3D Competitive Gaming Platform",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-fileinfo": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Core/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "migrate": "php database/migrate.php",
    "seed": "php database/seed.php"
  }
}
